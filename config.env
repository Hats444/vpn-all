# config.env — configuracao do anon-up. Permissao 600 (o script corrige se estiver aberta).
# Nada de chave aqui dentro: aponte para o .conf baixado do Proton VPN ou Mullvad.

# Arquivo WireGuard (.conf) do provedor. Ex.: /root/vpn/proton-br-1.conf
VPN_CONFIG_PATH=""
# Nome da interface do tunel (ate 15 caracteres)
WG_IFACE="anon0"

# Servidores DoH do dnscrypt-proxy (nomes da lista public-resolvers)
DNS_UPSTREAM="quad9-doh-ip4-port443-filter-pri mullvad-doh"

# Listas de bloqueio (hosts, dominio puro ou formato adblock)
BLOCKLIST_URLS="https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts https://raw.githubusercontent.com/hagezi/dns-blocklists/main/hosts/pro.txt https://big.oisd.nl"
# Baixa de novo se as listas tiverem mais que isso (horas)
BLOCKLIST_MAX_AGE_H=24
BLOCK_ENABLED=1

# 1 = liga o Tor junto (mesmo que --tor)
TOR_ENABLED=0
# 1 = sem VPN, sem internet
KILLSWITCH=1
# 1 = libera a rede local (impressora, NAS) mesmo com o kill switch
ALLOW_LAN=0
# 1 = desliga IPv6 para nao vazar o prefixo real
BLOCK_IPV6=1
# 1 = MAC aleatorio via NetworkManager (vale na proxima conexao)
MAC_RANDOMIZE=1
# 1 = desliga Avahi, mDNS e LLMNR
DISABLE_LEAKY_SERVICES=1
# Hostname generico (vazio = nao troca)
GENERIC_HOSTNAME="anon-host"

# Termux sem root: DNS privado sugerido para o Android
ANDROID_PRIVATE_DNS="dns.mullvad.net"
